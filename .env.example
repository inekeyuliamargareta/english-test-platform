PORT=3000
# Database MySQL (default Laragon: root tanpa password)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=englishon_toefl_ielts
# Ganti dengan teks acak panjang di server produksi
JWT_SECRET=ganti-dengan-teks-acak-panjang
# Asal domain frontend jika dipisah (kosongkan bila satu server)
CORS_ORIGIN=

# Kontak EnglishOn (tampil di tombol WhatsApp & halaman terkunci). ponytail: placeholder, isi data asli dari klien.
CONTACT_NAME=EnglishOn Ponorogo
CONTACT_ADDRESS=Jl. (alamat kantor EnglishOn), Ponorogo, Jawa Timur
CONTACT_WA=6281200000000
CONTACT_WA_LABEL=0812-0000-0000
CONTACT_HOURS=Senin–Sabtu, 08.00–20.00 WIB

# Akun awal dari `npm run seed` (khusus pengembangan; ganti password admin setelah online)
SEED_ADMIN_EMAIL=admin@englishon.test
SEED_PASSWORD=englishon123
